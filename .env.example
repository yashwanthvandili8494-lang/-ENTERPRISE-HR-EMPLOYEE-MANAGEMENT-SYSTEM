# Root environment template — copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env

# Backend
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/enterprise_hr_db
JWT_SECRET=replace_with_a_64_char_cryptographically_secure_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_cryptographically_secure_random_secret
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Frontend (see frontend/.env.example)
VITE_API_URL=http://localhost:5000/api
